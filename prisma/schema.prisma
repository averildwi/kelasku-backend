// KelasKu data model. See docs/DATA_MODEL.md.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------- enums ----------

enum GlobalRole {
  WALI_KELAS
  MURID
}

enum ClassRole {
  KETUA
  BENDAHARA
  MEMBER
}

enum MemberStatus {
  ACTIVE
  KICKED
  LEFT
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

enum NotificationType {
  ANNOUNCEMENT_NEW
  ROLE_ASSIGNED
  KICKED
  POLL_NEW
  PICKET_REMINDER
  CASH_DUE_NEW
}

enum CashType {
  INCOME
  EXPENSE
}

enum PaymentStatus {
  UNPAID
  PAID
}

// ---------- auth ----------

model User {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  email           String    @unique
  passwordHash    String?
  globalRole      GlobalRole
  avatarUrl       String?
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  tokenVersion    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  otpCodes        OtpCode[]
  memberships     ClassMember[]
  kickedMembers   ClassMember[]    @relation("kickedBy")
  ownedClassrooms Classroom[]      @relation("homeroomTeacher")
  announcements   Announcement[]
  whiteboardNotes WhiteboardNote[]
  polls           Poll[]
  cashRecords     CashTransaction[] @relation("recordedBy")
  duesCreated     CashDue[]
  paymentsMarked  CashDuePayment[]  @relation("recordedBy")
  deviceTokens    DeviceToken[]
  notifications   Notification[]
  votes           PollVote[]
  reads           AnnouncementRead[]

  @@map("users")
}

model OtpCode {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @db.Uuid
  purpose   OtpPurpose
  codeHash  String
  attempts  Int        @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@map("otp_codes")
}

// ---------- classroom ----------

model Classroom {
  id                String    @id @default(uuid()) @db.Uuid
  name              String
  schoolName        String?
  academicYear      String?
  code              String    @unique
  isLocked          Boolean   @default(false)
  maxStudents       Int?
  homeroomTeacherId String    @db.Uuid
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  homeroomTeacher   User      @relation("homeroomTeacher", fields: [homeroomTeacherId], references: [id], onDelete: Restrict)

  members          ClassMember[]
  announcements    Announcement[]
  subjects         Subject[]
  lessonSchedules  LessonSchedule[]
  whiteboardNotes  WhiteboardNote[]
  picketGroups     PicketGroup[]
  polls            Poll[]
  cashTransactions CashTransaction[]
  cashDues         CashDue[]
  notifications    Notification[]

  @@index([homeroomTeacherId])
  @@map("classrooms")
}

model ClassMember {
  id         String       @id @default(uuid()) @db.Uuid
  classId    String       @db.Uuid
  userId     String       @db.Uuid
  role       ClassRole    @default(MEMBER)
  status     MemberStatus @default(ACTIVE)
  isActive   Boolean      @default(true)
  joinedAt   DateTime     @default(now())
  leftAt     DateTime?
  kickedById String?      @db.Uuid
  kickReason String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  classroom  Classroom    @relation(fields: [classId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kickedBy   User?        @relation("kickedBy", fields: [kickedById], references: [id], onDelete: SetNull)

  picketSeats PicketMember[]
  payments    CashDuePayment[]

  @@unique([classId, userId])
  @@index([userId, status])
  @@map("class_members")
}

// One active membership per student (BR-2) and one office per class (BR-1)
// cannot be plain Prisma unique constraints. The service enforces them in the
// join/assign-role transaction; these partial indexes are the concurrency
// backstop and are applied manually after the migration (see migration SQL):
//   CREATE UNIQUE INDEX one_active_membership ON "class_members" ("userId") WHERE "isActive" = true;
//   CREATE UNIQUE INDEX one_active_ketua ON "class_members" ("classId") WHERE "role" = 'KETUA' AND "isActive" = true;
//   CREATE UNIQUE INDEX one_active_bendahara ON "class_members" ("classId") WHERE "role" = 'BENDAHARA' AND "isActive" = true;

// ---------- announcements ----------

model Announcement {
  id        String    @id @default(uuid()) @db.Uuid
  classId   String    @db.Uuid
  authorId  String    @db.Uuid
  title     String
  content   String
  isPinned  Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  classroom Classroom    @relation(fields: [classId], references: [id], onDelete: Cascade)
  author    User         @relation(fields: [authorId], references: [id], onDelete: Restrict)
  reads     AnnouncementRead[]

  @@index([classId, isPinned, createdAt])
  @@map("announcements")
}

model AnnouncementRead {
  announcementId String   @db.Uuid
  userId         String   @db.Uuid
  readAt         DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
  @@map("announcement_reads")
}

// ---------- subjects & schedules ----------

model Subject {
  id          String    @id @default(uuid()) @db.Uuid
  classId     String    @db.Uuid
  name        String
  teacherName String?
  color       String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  classroom   Classroom       @relation(fields: [classId], references: [id], onDelete: Cascade)
  schedules   LessonSchedule[]
  whiteboards WhiteboardNote[]

  @@index([classId])
  @@map("subjects")
}

model LessonSchedule {
  id        String @id @default(uuid()) @db.Uuid
  classId   String @db.Uuid
  subjectId String @db.Uuid
  dayOfWeek Int
  startTime String
  endTime   String
  room      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  classroom Classroom @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@index([classId, dayOfWeek])
  @@map("lesson_schedules")
}

// ---------- whiteboard ----------

model WhiteboardNote {
  id         String    @id @default(uuid()) @db.Uuid
  classId    String    @db.Uuid
  subjectId  String    @db.Uuid
  uploaderId String    @db.Uuid
  date       DateTime  @db.Date
  caption    String?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  classroom  Classroom     @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject    Subject       @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  uploader   User          @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  images     WhiteboardImage[]

  @@index([classId, date])
  @@index([classId, subjectId])
  @@map("whiteboard_notes")
}

model WhiteboardImage {
  id                 String @id @default(uuid()) @db.Uuid
  noteId             String @db.Uuid
  url                String
  cloudinaryPublicId String
  width              Int
  height             Int
  position           Int    @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  note               WhiteboardNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@map("whiteboard_images")
}

// ---------- pickets ----------

model PicketGroup {
  id        String @id @default(uuid()) @db.Uuid
  classId   String @db.Uuid
  dayOfWeek Int
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  classroom Classroom      @relation(fields: [classId], references: [id], onDelete: Cascade)
  seats     PicketMember[]

  @@unique([classId, dayOfWeek])
  @@map("picket_groups")
}

model PicketMember {
  groupId   String   @db.Uuid
  memberId  String   @db.Uuid
  createdAt DateTime @default(now())
  group     PicketGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member    ClassMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([groupId, memberId])
  @@map("picket_members")
}

// ---------- polls ----------

model Poll {
  id            String    @id @default(uuid()) @db.Uuid
  classId       String    @db.Uuid
  creatorId     String    @db.Uuid
  question      String
  deadline      DateTime?
  allowMultiple Boolean   @default(false)
  isAnonymous   Boolean   @default(false)
  closedAt      DateTime?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  classroom     Classroom @relation(fields: [classId], references: [id], onDelete: Cascade)
  creator       User      @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  options       PollOption[]
  votes         PollVote[]

  @@index([classId, createdAt])
  @@map("polls")
}

model PollOption {
  id        String @id @default(uuid()) @db.Uuid
  pollId    String @db.Uuid
  label     String
  position  Int    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes     PollVote[]

  @@index([pollId])
  @@map("poll_options")
}

model PollVote {
  id        String   @id @default(uuid()) @db.Uuid
  pollId    String   @db.Uuid
  optionId  String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([pollId, optionId, userId])
  @@map("poll_votes")
}

// ---------- cash ----------

model CashTransaction {
  id           String    @id @default(uuid()) @db.Uuid
  classId      String    @db.Uuid
  type         CashType
  amount       Int
  description  String
  date         DateTime  @db.Date
  proofUrl     String?
  recordedById String    @db.Uuid
  duePaymentId String?   @db.Uuid @unique
  voidedAt     DateTime?
  voidReason   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  classroom    Classroom       @relation(fields: [classId], references: [id], onDelete: Cascade)
  recordedBy   User            @relation("recordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  duePayment   CashDuePayment? @relation(fields: [duePaymentId], references: [id], onDelete: SetNull)

  @@index([classId, date])
  @@index([classId, type])
  @@map("cash_transactions")
}

model CashDue {
  id          String    @id @default(uuid()) @db.Uuid
  classId     String    @db.Uuid
  title       String
  amount      Int
  dueDate     DateTime? @db.Date
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  classroom   Classroom      @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdBy   User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  payments    CashDuePayment[]

  @@index([classId, createdAt])
  @@map("cash_dues")
}

model CashDuePayment {
  id           String        @id @default(uuid()) @db.Uuid
  dueId        String        @db.Uuid
  memberId     String        @db.Uuid
  status       PaymentStatus @default(UNPAID)
  paidAt       DateTime?
  recordedById String?       @db.Uuid
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  due          CashDue       @relation(fields: [dueId], references: [id], onDelete: Cascade)
  member       ClassMember   @relation(fields: [memberId], references: [id], onDelete: Restrict)
  recordedBy   User?         @relation("recordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  transaction  CashTransaction?

  @@unique([dueId, memberId])
  @@index([memberId])
  @@map("cash_due_payments")
}

// ---------- notifications ----------

model DeviceToken {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  token      String         @unique
  platform   DevicePlatform
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  classId   String?          @db.Uuid
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  classroom Classroom?       @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model NotificationLog {
  id        String           @id @default(uuid()) @db.Uuid
  type      NotificationType
  refId     String
  userId    String           @db.Uuid
  sentDate  DateTime         @db.Date
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([type, refId, userId, sentDate])
  @@map("notification_logs")
}